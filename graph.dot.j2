{% set FSM_PREFIX = PREFIX.upper() %}
{% set fsm_prefix = FSM_PREFIX.lower() %}
digraph {{fsm_prefix}}_fsm {
        nodesep = 1.0;
        ranksep = 1.5;
        sep = 1.0;

	node [shape = doublecircle] {{states[0]['State']}};
	node [shape = circle];

{% for state_name, state in transitions.items() %}
	{% for st in state %}
	{{state_name}} -> {{st.New_State}} [label = "{{st.Event}}"];
	{% endfor %}
{% endfor %}

{% if wildcard_transitions %}
	note [shape = note, style = filled, fillcolor = "#FFF3CD",
		label = "Global transitions (from any state):\n{% for wt in wildcard_transitions %}  {{wt.Event}} -> {{wt.New_State}}\l{% endfor %}"];
{% endif %}
}
